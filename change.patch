+/**
+ * Простейшее определение mime по расширению.
+ * Если не распознали — вернём image/jpeg.
+ */
+const getMimeFromUrl = (url: string): string => {
+  const u = url.toLowerCase();
+  if (u.endsWith(".png")) return "image/png";
+  if (u.endsWith(".webp")) return "image/webp";
+  if (u.endsWith(".gif")) return "image/gif";
+  if (u.endsWith(".bmp")) return "image/bmp";
+  if (u.endsWith(".svg")) return "image/svg+xml";
+  return "image/jpeg";
+};
+
+/**
+ * Преобразует входной content (string | [{text}|{image_url}...])
+ * в массив частей Assistants v2 для gpt-4o:
+ *  - { type: "input_text", text }
+ *  - { type: "input_image", image_data: { data: base64, mime_type } }
+ * Изображения читаем с диска, если URL локальный ("/uploads/...").
+ * Иначе подставляем URL текстом (безопасный fallback).
+ */
+const buildAssistantContentParts = (content: Content) => {
+  const parts: any[] = [];
+
+  // Строка -> один input_text
+  if (typeof content === "string") {
+    const txt = content.trim();
+    if (txt) parts.push({ type: "input_text", text: txt });
+    return parts;
+  }
+
+  if (!Array.isArray(content)) return parts;
+
+  const publicRoot = path.join(process.cwd(), "public");
+
+  for (const p of content) {
+    if (!p || typeof p !== "object") continue;
+    // текстовые части
+    if ((p as any).type === "text" && typeof (p as any).text === "string") {
+      const txt = (p as any).text.trim();
+      if (txt) parts.push({ type: "input_text", text: txt });
+      continue;
+    }
+    // изображения
+    if ((p as any).type === "image_url" && (p as any).image_url?.url) {
+      const url: string = (p as any).image_url.url;
+      try {
+        // локальные файлы: "/uploads/..."
+        if (url.startsWith("/")) {
+          const abs = path.join(publicRoot, url);
+          if (!abs.startsWith(publicRoot)) {
+            // защита от выхода за public
+            parts.push({ type: "input_text", text: `Attachment (image): ${url}` });
+            continue;
+          }
+          const buf = fs.readFileSync(abs);
+          const b64 = buf.toString("base64");
+          const mime = getMimeFromUrl(url);
+          parts.push({
+            type: "input_image",
+            image_data: { data: b64, mime_type: mime },
+          });
+        } else {
+          // Внешние URL (без HTTPS у тебя может не загрузиться на стороне OpenAI),
+          // поэтому используем безопасный fallback — просто текст со ссылкой.
+          parts.push({ type: "input_text", text: `Attachment (image url): ${url}` });
+        }
+      } catch {
+        parts.push({ type: "input_text", text: `Attachment (image url): ${url}` });
+      }
+    }
+  }
+
+  return parts;
+};
