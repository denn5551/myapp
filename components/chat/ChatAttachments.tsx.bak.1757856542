import React, { useEffect, useState } from "react";
import { uploadsStore, type UploadItem } from "./uploads-store";

export default function ChatAttachments() {
  const [items, setItems] = useState<UploadItem[]>(uploadsStore.get());

  useEffect(() => {
    const off = uploadsStore.subscribe(setItems);
    return () => { try { off && off(); } catch {} };
  }, []);

  if (!items.length) return null;

  return (
    <div className="flex flex-wrap gap-2 mt-2">
      {items.map((it) => (
        <div key={it.url} className="relative border rounded-lg p-1">
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img src={it.url} alt={it.name ?? "attachment"} className="w-[150px] h-auto object-cover rounded" />
          <button
            type="button"
            onClick={() => uploadsStore.remove(it.url)}
            className="absolute -top-2 -right-2 bg-white border rounded-full w-6 h-6"
            title="Убрать"
          >
            ✕
          </button>
        </div>
      ))}
      <button
        type="button"
        onClick={() => uploadsStore.clear()}
        className="ml-2 text-xs underline"
        title="Очистить все вложения"
      >
        очистить все
      </button>
    </div>
  );
}
