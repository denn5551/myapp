components/chat/ChatInput.tsx

import React, { useCallback, useState } from "react";
import ChatUploader, { UploadedFile } from "./ChatUploader";

type Props = {
  threadId?: string;
  assistantId?: string;
  onMessageSent?: (
    ok: boolean,
    newThreadId?: string,
    response?: string,
    userMessage?: string
  ) => void;
};

const ChatInput: React.FC<Props> = ({ threadId, assistantId, onMessageSent }) => {
  const [text, setText] = useState("");
  const [attachments, setAttachments] = useState<UploadedFile[]>([]);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleFilesChange = useCallback((items: UploadedFile[]) => {
    setAttachments(items || []);
  }, []);

  // Вставка из буфера обмена
  const handlePaste = async (e: React.ClipboardEvent<HTMLTextAreaElement>) => {
    const items = e.clipboardData?.items;
    if (!items?.length) return;

    const files: File[] = [];
    for (const it of items as unknown as DataTransferItem[]) {
      if ((it as any).kind === "file") {
        const f = (it as any).getAsFile?.();
        if (f) files.push(f);
      }
    }
    if (!files.length) return;

    // На paste тоже грузим через /api/upload
    try {
      const fd = new FormData();
      for (const f of files) fd.append("files", f);
      const r = await fetch("/api/upload", { method: "POST", body: fd });
      const data = await r.json().catch(() => ({} as any));
      if (r.ok && data?.ok && Array.isArray(data.files)) {
        setAttachments((prev) => [...prev, ...data.files]);
      }
    } catch {
      // молчим — это просто paste
    }
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
      e.preventDefault();
      void handleSend();
    }
  };

  const handleSend = async () => {
    setError(null);
    const hasText = text.trim().length > 0;
    const hasFiles = attachments.length > 0;
    if (!hasText && !hasFiles) return;

    // Собираем parts для Assistants
    const parts: any[] = [];
    if (hasText) parts.push({ type: "text", text: text.trim() });

    for (const f of attachments) {
      if (f.isImage || /^image\//.test(f.type || "")) {
        parts.push({ type: "image_url", image_url: { url: f.url } });
      } else {
        const link = `\n[Файл: ${f.name}] ${f.url}`;
        if (parts.length && parts[0].type === "text") {
          parts[0].text += link;
        } else {
          parts.unshift({ type: "text", text: link });
        }
      }
    }

    setBusy(true);
    try {
      const body: any = {
        assistant_id: assistantId,
        thread_id: threadId,
        content: parts, // <-- единый ключ для бэка
      };

      const r = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      const data = await r.json().catch(() => ({} as any));
      if (!r.ok || data?.error) {
        throw new Error(
          data?.details?.message || data?.error || "Ошибка отправки сообщения"
        );
      }

      // очищаем
      const sent = text.trim();
      setText("");
      setAttachments([]);

      onMessageSent?.(true, data.thread_id, data?.message?.content, sent);
    } catch (e: any) {
      setError(e?.message || "Ошибка отправки сообщения");
      onMessageSent?.(false);
    } finally {
      setBusy(false);
    }
  };

  return (
    <div className="w-full rounded-2xl border border-gray-200 p-3">
      <textarea
        className="min-h-[80px] w-full resize-y rounded-xl border border-gray-200 p-3 outline-none focus:border-gray-300"
        placeholder="Напишите сообщение… (Ctrl/⌘+Enter — отправить)"
        aria-label="Поле ввода сообщения"
        value={text}
        onChange={(e) => setText(e.target.value)}
        onKeyDown={handleKeyDown}
        onPaste={handlePaste}
      />

      <div className="mt-3">
        <ChatUploader value={attachments} onFilesChange={handleFilesChange} />
      </div>

      <div className="mt-3 flex items-center justify-between">
        <div className="text-xs text-gray-500">
          {attachments.length ? `${attachments.length} влож.` : "Нет вложений"}
          {busy ? " • отправляем…" : " • готово к отправке"}
        </div>
        <button
          type="button"
          className="rounded-xl bg-black px-4 py-2 text-white hover:opacity-90 focus:outline-none disabled:opacity-50"
          onClick={handleSend}
          aria-label="Отправить сообщение"
          disabled={busy}
        >
          Отправить
        </button>
      </div>

      {error && <div className="mt-2 text-xs text-red-600">{error}</div>}
    </div>
  );
};

export default
